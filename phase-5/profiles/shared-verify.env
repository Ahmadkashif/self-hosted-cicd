# Profile "shared-verify" — bring the blueprint up on a box that ALREADY runs other workloads (LLM serving,
# observability, desktop), for verification or a small personal forge. Minimum requirements, not detection.
# The floors below are FREE capacity after co-tenants: run `./detect-host.sh --env host.env` and
# `python3 render.py shared-verify --host host.env` so the budget subtracts what is already running.
# Everything runs in VMs (forge VM, runner VM, deploy-target VM); nothing of the stack touches the host's Docker,
# ports or firewall. Measured idle on the 2026-10-14 Linux bring-up (../proof-linux/q11-measure/): Forgejo 193 MiB,
# Postgres 47, Caddy 18, mirror 24, each runner 8-32, each fresh dind 30-36 (230-658 after builds, page cache),
# kamal-proxy 4. The *_MEM_LIMIT values below are PEAK budgets, not idle. On the host each VM costs its full size
# (QEMU RSS = allocation once the guest page cache fills), so budget whole VMs.
PROFILE=shared-verify
HOST_MIN_THREADS=8
HOST_MIN_FREE_THREADS=6
HOST_MIN_RAM_GB=12
HOST_MIN_DISK_GB=100
HOST_REQUIRES=x86-64 with VT-x/AMD-V (KVM) usable by the operator, SSD; >= 12 GB RAM AVAILABLE after co-tenants

# --- forge (runs in its own VM: FORGE_PLACEMENT=vm) ---
FORGE_PLACEMENT=vm
FORGE_VM_VCPUS=2
FORGE_VM_RAM_GB=3
FORGE_VM_DISK_GB=30
FORGEJO_TAG=15-rootless
FORGEJO_DB=postgres
FORGEJO_MEM_LIMIT=768m
FORGEJO_RAM_GB=0.75
POSTGRES_TAG=17
POSTGRES_MEM_LIMIT=384m
POSTGRES_RAM_GB=0.375
REGISTRY_TAG=3
REGISTRY_MEM_LIMIT=256m
EDGE_RAM_GB=0.25
CADDY_TAG=2

# --- runner VM ---
RUNNER_VM_VCPUS=4
RUNNER_VM_RAM_GB=6
RUNNER_VM_DISK_GB=40
RUNNER_TAG=13
DIND_TAG=29-dind
CI_SLOTS=1
CI_SLOT_CPUS=2
CI_SLOT_MEM_GB=3
DEPLOY_SLOTS=1
DEPLOY_SLOT_CPUS=1
DEPLOY_SLOT_MEM_GB=2
GITHUB_SLOTS=0
GITHUB_SLOT_CPUS=2
GITHUB_SLOT_MEM_GB=4
JOB_TIMEOUT=30m

# --- deploy target (its own small VM; apps are not on the host) ---
TARGET_VM_VCPUS=1
TARGET_VM_RAM_GB=1.25
APPS_RAM_GB=0
CD_TOOL=kamal
