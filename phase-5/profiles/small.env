# Profile S — "CI box". Minimum host requirements (not detection): these are the floor this profile is sized for.
PROFILE=small
HOST_MIN_THREADS=8
HOST_MIN_RAM_GB=16
HOST_MIN_DISK_GB=512
HOST_REQUIRES=x86-64 with VT-x/AMD-V (KVM), NVMe SSD, 1 GbE

# --- forge host services (compose: forge-host/compose.yaml) ---
FORGEJO_TAG=15-rootless
FORGEJO_DB=sqlite3
FORGEJO_MEM_LIMIT=768m
FORGEJO_RAM_GB=0.75
POSTGRES_TAG=17
POSTGRES_MEM_LIMIT=512m
POSTGRES_RAM_GB=0
REGISTRY_TAG=3
REGISTRY_MEM_LIMIT=256m
EDGE_RAM_GB=0.25
CADDY_TAG=2

# --- runner VM (create this VM on the hypervisor; compose: runner-vm/compose.yaml) ---
RUNNER_VM_VCPUS=4
RUNNER_VM_RAM_GB=8
RUNNER_VM_DISK_GB=150
RUNNER_TAG=13
DIND_TAG=29-dind
CI_SLOTS=1
CI_SLOT_CPUS=2
CI_SLOT_MEM_GB=4
DEPLOY_SLOTS=1
DEPLOY_SLOT_CPUS=2
DEPLOY_SLOT_MEM_GB=3
GITHUB_SLOTS=0
GITHUB_SLOT_CPUS=2
GITHUB_SLOT_MEM_GB=4
JOB_TIMEOUT=30m

# --- workloads left on the host ---
APPS_RAM_GB=3
CD_TOOL=kamal
