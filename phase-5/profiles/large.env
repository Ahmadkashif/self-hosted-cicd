# Profile L — "CI farm + k8s option". Minimum host requirements (not detection).
# For heavy stacks (Rust/JVM/Android/E2E) use 128 GB and raise *_SLOT_MEM_GB to 12.
PROFILE=large
HOST_MIN_THREADS=32
HOST_MIN_RAM_GB=64
HOST_MIN_DISK_GB=2000
HOST_REQUIRES=x86-64 with VT-x/AMD-V (KVM), NVMe SSD (TBW >= 1200 TB) + separate backup disk, 2.5 GbE

FORGEJO_TAG=15-rootless
FORGEJO_DB=postgres
FORGEJO_MEM_LIMIT=1g
FORGEJO_RAM_GB=1
POSTGRES_TAG=17
POSTGRES_MEM_LIMIT=2g
POSTGRES_RAM_GB=2
REGISTRY_TAG=3
REGISTRY_MEM_LIMIT=512m
EDGE_RAM_GB=0.5
CADDY_TAG=2

RUNNER_VM_VCPUS=18
RUNNER_VM_RAM_GB=39
RUNNER_VM_DISK_GB=600
RUNNER_TAG=13
DIND_TAG=29-dind
CI_SLOTS=3
CI_SLOT_CPUS=4
CI_SLOT_MEM_GB=8
DEPLOY_SLOTS=1
DEPLOY_SLOT_CPUS=2
DEPLOY_SLOT_MEM_GB=6
GITHUB_SLOTS=1
GITHUB_SLOT_CPUS=4
GITHUB_SLOT_MEM_GB=8
JOB_TIMEOUT=60m

APPS_RAM_GB=10
CD_TOOL=kamal
