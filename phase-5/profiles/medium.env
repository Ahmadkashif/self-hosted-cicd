# Profile M — "CI + apps". Minimum host requirements (not detection).
PROFILE=medium
HOST_MIN_THREADS=16
HOST_MIN_RAM_GB=32
HOST_MIN_DISK_GB=1000
HOST_REQUIRES=x86-64 with VT-x/AMD-V (KVM), NVMe SSD (TBW >= 600 TB), 1 GbE

FORGEJO_TAG=15-rootless
FORGEJO_DB=postgres
FORGEJO_MEM_LIMIT=1g
FORGEJO_RAM_GB=1
POSTGRES_TAG=17
POSTGRES_MEM_LIMIT=1g
POSTGRES_RAM_GB=1
REGISTRY_TAG=3
REGISTRY_MEM_LIMIT=256m
EDGE_RAM_GB=0.25
CADDY_TAG=2

RUNNER_VM_VCPUS=8
RUNNER_VM_RAM_GB=16
RUNNER_VM_DISK_GB=300
RUNNER_TAG=13
DIND_TAG=29-dind
CI_SLOTS=2
CI_SLOT_CPUS=2
CI_SLOT_MEM_GB=4
DEPLOY_SLOTS=1
DEPLOY_SLOT_CPUS=2
DEPLOY_SLOT_MEM_GB=3
GITHUB_SLOTS=1
GITHUB_SLOT_CPUS=2
GITHUB_SLOT_MEM_GB=4
JOB_TIMEOUT=45m

APPS_RAM_GB=8
CD_TOOL=kamal
