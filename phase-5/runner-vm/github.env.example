# /etc/ci-runner/github.env  (root:root 0600) — GitHub App credentials used ONLY to mint runner registration tokens.
# App permissions: Organization "Self-hosted runners: read & write" (org scope). Nothing else.
# (Repo scope — personal accounts — needs Repository "Administration: read & write" instead, which is broad.)
# APP_PRIVATE_KEY: one line with literal \n escapes; the myoung34 entrypoint converts them to newlines.
# APP_LOGIN defaults to ORG_NAME for org scope.
APP_ID=123456
APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
